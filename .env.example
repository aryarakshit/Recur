# Discord Bot Credentials
DISCORD_TOKEN=

# LLM Provider Configuration
LLM_PROVIDER=groq

# Provider API Key
GROQ_API_KEY=

# Model Configurations
LLM_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=text-embedding-004

# Discord Channel & Role Configuration
ORGANIZER_CHANNEL_ID=
ORGANIZER_CHANNEL_NAME=#help
ADMIN_ROLE_ID=
CORE_MEMBER_ROLE_ID=
VOLUNTEER_ROLE_ID=
MAINTAINER_ROLE_ID=
MAINTAINER_MENTION=@Core Member or @Volunteer
ALLOWED_ROLES=hacker,hackers,participant,participants
EXCLUDED_ROLES=admin,administrator,moderator,mod,core member,core mem,volunteer,judge,bot,dyno
MODERATOR_MODE=true
TEAM_FINDING_CHANNELS=find-your-team,find-your-team!

# Discord presence
BOT_ACTIVITY=hackathon questions | help desk

# Storage & Index Paths
DATABASE_PATH=data/hackbot.db
FAISS_INDEX_PATH=data/faiss.index
METADATA_PATH=data/metadata.json
